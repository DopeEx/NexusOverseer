{
  "manifest_version": 3,
  "name": "Nexus Overseer",
  "version": "2.3.0",
  "description": "Tracks Nexus Legacy survey and pirate data — aggregates resources collected and ships lost, with daily and hourly breakdowns.",
  "author": "DopeEx, Verrok",
  "homepage_url": "https://github.com/DopeEx/NexusOverseer",
  "permissions": [
    "tabs",
    "cookies",
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "downloads",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://*.nexuslegacy.space/*",
    "https://s0.nexuslegacy.space/*",
    "https://nexuslegacy.space/*",
    "https://raw.githubusercontent.com/DopeEx/NexusOverseer/*"
  ],
  "background": {
    "service_worker": "background-sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nexus Overseer",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.nexuslegacy.space/*"],
      "js": ["diagnostics-core.js", "diagnostics-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "game-api-client.js", "diagnostics-relay.js", "galaxy-cache-relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "sidebar-inject.js"],
      "css": ["theme.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "galaxy-fetch-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "galaxy-fields.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "empire-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "guide-content.js", "guide-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "logistics-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "upgrade-queue.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "building-upgrade.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "tech-upgrade.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://*.nexuslegacy.space/*"],
      "js": ["server-storage.js", "ship-upgrade.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "asteroid-search.js",
        "diagnostics-core.js"
      ],
      "matches": [
        "https://s0.nexuslegacy.space/*",
        "https://*.nexuslegacy.space/*",
        "https://nexuslegacy.space/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nexus-overseer@dopeex",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
